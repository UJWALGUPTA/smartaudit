# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave empty to use the embedded MongoDB (downloaded on first run, persisted
# to ./.data/db on port 27018). Set it to use your own instance, e.g.
#   MONGO_URI=mongodb://localhost:27017/smartaudit
MONGO_URI=

API_PORT=4000

# Requests without an `x-tenant-id` header are scoped to this tenant.
DEFAULT_TENANT_ID=66a0c0ffee00000000000001

# ---------------------------------------------------------------------------
# AI engine
# ---------------------------------------------------------------------------
# MOCK_AI=true uses the local deterministic simulation engine (no network).
# Set MOCK_AI=false and provide OPENAI_API_KEY to use a live LLM.
MOCK_AI=true
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (e.g. https://api.groq.com/openai/v1).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Leave empty to compute 8-dim vectors locally (e.g. when the provider has no
# embeddings API, like Groq).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Client-side rate limit for LLM calls (requests per minute).
AI_MAX_RPM=60
AI_REQUEST_TIMEOUT_MS=15000
# Fall back to the local engine when the LLM keeps failing.
AI_FALLBACK_TO_MOCK=true
# Simulated latency of the mock engine.
MOCK_AI_DELAY_MS=400
# Probability (0-1) that the mock engine throws, to demo retries/backoff.
MOCK_AI_FAILURE_RATE=0

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
# Must comfortably exceed AI_REQUEST_TIMEOUT_MS (x retries) so a live job is
# never reclaimed by another worker.
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=4
WORKER_BACKOFF_BASE_MS=2000
